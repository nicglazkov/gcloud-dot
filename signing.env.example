# Copy to signing.env and fill in. That file is gitignored.
#
# None of this is needed to build or run GCloud Dot. Without it the app is
# signed ad hoc, which works locally and is what CI does for pull requests.
# Apple will not notarize an ad-hoc signature, so a release needs these.
#
# Everything here identifies *you* as the publisher, which is why it is not
# checked in: a signing identity and a Team ID belong to whoever ships the app,
# not to the project.

# Exactly as `security find-identity -v -p codesigning` prints it.
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
TEAM_ID="TEAMID1234"

# An App Store Connect API key, from App Store Connect > Users and Access >
# Integrations > App Store Connect API. Preferred over an Apple ID and an
# app-specific password: it needs no interactive keychain entry, so the same
# values work locally and in CI.
#
# Keep the .p8 outside the repository.
ASC_KEY_PATH="/path/to/AuthKey_XXXXXXXXXX.p8"
ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER_ID="00000000-0000-0000-0000-000000000000"
